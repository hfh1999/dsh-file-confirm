{
  "name": "dsh-file-confirm",
  "version": "0.1.1",
  "description": "文件改动确认机制（双面插件）：write/edit/str_replace_editor 写入前弹出确认条，内嵌 GitHub 风格 diff（行号 + 红删绿增），允许本次 / 拒绝。File-change confirmation with inline diff for DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "approval",
    "diff",
    "file-change",
    "confirmation"
  ],
  "homepage": "https://github.com/hfh1999/dsh-file-confirm",
  "repository": {
    "type": "git",
    "url": "https://github.com/hfh1999/dsh-file-confirm.git"
  },
  "bugs": {
    "url": "https://github.com/hfh1999/dsh-file-confirm/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "dsh-file-confirm contributors"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "showtime.png"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
